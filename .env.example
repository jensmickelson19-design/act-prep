# Local dev (Docker Postgres from docker-compose.yml)
# DATABASE_URL="postgresql://act:act@localhost:5433/act_prep?schema=public"

# Production (Neon) — use the POOLED connection string for the app.
# Looks like: postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=""

# Neon DIRECT (non-pooled) connection — used by Prisma for migrations only.
# Looks like: postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require
DIRECT_URL=""

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Required on Vercel so NextAuth trusts the X-Forwarded-* headers.
AUTH_TRUST_HOST=true

# Public site origin, used for OpenGraph/canonical URLs (metadataBase) and
# transactional email links. No trailing slash. On Vercel, VERCEL_URL is used
# automatically if this is unset, but a stable custom-domain value is better.
NEXT_PUBLIC_APP_URL="https://actprep.example.com"

# Stripe billing ($20/mo subscription with 7-day trial). When these are unset,
# the paywall is disabled and the app is fully open (local dev convenience).
# STRIPE_SECRET_KEY: Developers -> API keys (sk_test_... / sk_live_...)
# STRIPE_PRICE_ID:   the recurring $20/mo Price id (price_...)
# STRIPE_WEBHOOK_SECRET: from the webhook endpoint (whsec_...); locally use
#   `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# Error tracking (Sentry). All optional — the SDK is fully inert when SENTRY_DSN
# / NEXT_PUBLIC_SENTRY_DSN are unset, and only reports in NODE_ENV=production.
#   SENTRY_DSN:              server + edge DSN (project settings -> Client Keys)
#   NEXT_PUBLIC_SENTRY_DSN:  browser DSN (usually the same value)
# Source-map upload at build time is skipped unless all three below are set:
#   SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
